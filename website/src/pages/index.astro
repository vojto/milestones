---
import '../styles/global.css'

const appStoreUrl = 'https://apps.apple.com/app/id6795149910'
const privacyUrl =
  'https://github.com/vojto/milestones/blob/main/app/PRIVACY.md'
const supportUrl = 'https://github.com/vojto/milestones/issues'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Milestones is a private, local-first year calendar for Mac. See the shape of your year on one screen."
    />
    <meta name="theme-color" content="#f7f6f2" />
    <meta
      property="og:title"
      content="Milestones — See the shape of your year"
    />
    <meta
      property="og:description"
      content="A year on one screen. Your milestones paint their color across the days they ran."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://raw.githubusercontent.com/vojto/milestones/main/website/public/og.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Milestones — See the shape of your year"
    />
    <meta
      name="twitter:description"
      content="A year on one screen. Your milestones paint their color across the days they ran."
    />
    <meta
      name="twitter:image"
      content="https://raw.githubusercontent.com/vojto/milestones/main/website/public/og.png"
    />
    <link rel="icon" type="image/png" href="/app-icon-256.png" />
    <link rel="apple-touch-icon" href="/app-icon-256.png" />
    <title>Milestones — See the shape of your year</title>
  </head>
  <body class="bg-[#f7f6f2] text-[#151515] antialiased">
    <header
      class="mx-auto flex max-w-[1440px] items-center justify-between px-5 py-5 sm:px-8 lg:px-12"
    >
      <a
        href="#top"
        class="flex items-center gap-3"
        aria-label="Milestones home"
      >
        <img
          src="/app-icon-256.png"
          alt=""
          class="size-10 rounded-[10px] shadow-sm"
        />
        <span class="text-[17px] font-semibold tracking-[-0.02em]"
          >Milestones</span
        >
      </a>

      <nav class="flex items-center gap-2" aria-label="Main navigation">
        <a
          href="#features"
          class="hidden rounded-full px-4 py-2 text-sm font-medium text-black/60 transition hover:bg-black/5 hover:text-black sm:block"
        >
          Features
        </a>
        <a
          href={appStoreUrl}
          class="rounded-full bg-[#171717] px-5 py-2.5 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-black"
        >
          Get Milestones
        </a>
      </nav>
    </header>

    <main id="top">
      <section
        class="mx-auto max-w-[1440px] px-5 pb-10 pt-20 text-center sm:px-8 sm:pt-28 lg:px-12 lg:pt-36"
      >
        <div
          class="mx-auto mb-7 flex w-fit items-center gap-2 rounded-full border border-black/8 bg-white/75 px-3 py-2 shadow-sm backdrop-blur"
        >
          <span class="size-2 rounded-full bg-[#ff8e91]"></span>
          <span class="size-2 rounded-full bg-[#ffb260]"></span>
          <span class="size-2 rounded-full bg-[#ffd21f]"></span>
          <span class="size-2 rounded-full bg-[#a7ed35]"></span>
          <span
            class="ml-1 text-xs font-semibold tracking-[0.08em] text-black/55 uppercase"
            >Made for Mac</span
          >
        </div>

        <h1
          class="mx-auto max-w-5xl text-[clamp(3.5rem,8vw,7.75rem)] leading-[0.87] font-semibold tracking-[-0.075em] text-balance"
        >
          See the shape<br />of your year.
        </h1>
        <p
          class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-black/55 sm:text-xl"
        >
          Name the things that took up your year. Say when they ran. Milestones
          paints each chapter across the calendar.
        </p>

        <div
          class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
        >
          <a
            href={appStoreUrl}
            class="inline-flex min-w-56 items-center justify-center gap-2 rounded-full bg-[#171717] px-7 py-4 font-semibold text-white shadow-lg shadow-black/10 transition hover:-translate-y-0.5 hover:bg-black"
          >
            <span class="text-lg" aria-hidden="true"></span>
            View on Mac App Store
          </a>
          <span class="px-4 py-3 text-sm font-medium text-black/45"
            >Free · macOS</span
          >
        </div>
      </section>

      <section
        class="overflow-hidden px-3 pt-14 pb-24 sm:px-6 sm:pt-20 lg:px-10 lg:pb-36"
      >
        <div
          class="hero-glow mx-auto max-w-[1600px] rounded-[2rem] p-2 sm:rounded-[3rem] sm:p-4 lg:p-6"
        >
          <img
            src="/milestones-year.png"
            alt="Milestones showing a colorful year calendar alongside a list of life chapters"
            width="2000"
            height="1250"
            class="relative w-full rounded-[1.5rem] sm:rounded-[2.25rem]"
          />
        </div>
      </section>

      <section id="features" class="bg-[#171717] text-white">
        <div
          class="mx-auto max-w-[1440px] px-5 py-24 sm:px-8 sm:py-32 lg:px-12 lg:py-40"
        >
          <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
            <div>
              <p
                class="mb-6 text-sm font-semibold tracking-[0.12em] text-white/40 uppercase"
              >
                One timeline
              </p>
              <h2
                class="max-w-4xl text-[clamp(3rem,7vw,7rem)] leading-[0.9] font-semibold tracking-[-0.065em] text-balance"
              >
                Starting the next thing is how the last thing ends.
              </h2>
            </div>
            <p
              class="max-w-xl text-lg leading-8 text-white/55 lg:justify-self-end lg:pb-2"
            >
              No two milestones cover the same day. Begin a new chapter and the
              previous one closes naturally. Your year stays honest, legible,
              and whole.
            </p>
          </div>

          <div
            class="mt-20 grid overflow-hidden rounded-[2rem] border border-white/10 md:grid-cols-3 lg:mt-28"
          >
            <article
              class="border-b border-white/10 p-7 md:border-r md:border-b-0 lg:p-10"
            >
              <div class="mb-16 h-2 w-20 rounded-full bg-[#ff8e91]"></div>
              <h3 class="text-2xl font-semibold tracking-[-0.035em]">
                A year on one screen
              </h3>
              <p class="mt-4 leading-7 text-white/50">
                Every month. Every day. Every chapter that made the year yours.
              </p>
            </article>
            <article
              class="border-b border-white/10 p-7 md:border-r md:border-b-0 lg:p-10"
            >
              <div class="mb-16 h-2 w-20 rounded-full bg-[#ffd21f]"></div>
              <h3 class="text-2xl font-semibold tracking-[-0.035em]">
                Fast by design
              </h3>
              <p class="mt-4 leading-7 text-white/50">
                Create, rename, reorder, and undo without leaving the one view
                that matters.
              </p>
            </article>
            <article class="p-7 lg:p-10">
              <div class="mb-16 h-2 w-20 rounded-full bg-[#55d9af]"></div>
              <h3 class="text-2xl font-semibold tracking-[-0.035em]">
                Yours, on your Mac
              </h3>
              <p class="mt-4 leading-7 text-white/50">
                No account, no sync, no server. Your year never leaves your
                computer.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="overflow-hidden bg-[#f7f6f2]">
        <div
          class="mx-auto grid max-w-[1440px] gap-16 px-5 py-24 sm:px-8 sm:py-32 lg:grid-cols-2 lg:items-center lg:px-12 lg:py-40"
        >
          <div
            class="relative min-h-[380px] rounded-[2.5rem] bg-[#e8e4dc] p-7 sm:min-h-[520px] sm:p-12"
          >
            <div
              class="absolute inset-x-7 top-7 flex justify-between text-sm font-semibold text-black/40 sm:inset-x-12 sm:top-12"
            >
              <span>JAN</span><span>DEC</span>
            </div>
            <div
              class="absolute inset-x-7 top-1/2 -translate-y-1/2 space-y-4 sm:inset-x-12 sm:space-y-6"
            >
              <div class="h-12 w-[37%] rounded-xl bg-[#ff8e91] sm:h-16"></div>
              <div
                class="ml-[20%] h-12 w-[48%] rounded-xl bg-[#ffb260] sm:h-16"
              >
              </div>
              <div
                class="ml-[56%] h-12 w-[30%] rounded-xl bg-[#ffd21f] sm:h-16"
              >
              </div>
              <div
                class="ml-[72%] h-12 w-[28%] rounded-xl bg-[#55d9af] sm:h-16"
              >
              </div>
            </div>
            <p
              class="absolute right-7 bottom-7 left-7 text-sm font-medium text-black/40 sm:right-12 sm:bottom-12 sm:left-12"
            >
              Your life, without the spreadsheets.
            </p>
          </div>

          <div class="lg:pl-12">
            <p
              class="mb-5 text-sm font-semibold tracking-[0.12em] text-black/35 uppercase"
            >
              Just enough
            </p>
            <h2
              class="text-[clamp(3rem,6vw,6rem)] leading-[0.9] font-semibold tracking-[-0.065em] text-balance"
            >
              Track chapters, not hours.
            </h2>
            <p class="mt-8 max-w-xl text-lg leading-8 text-black/55">
              Milestones has no streaks to maintain and no boxes to tick. It
              remembers the broad shape of your time, then gets out of the way.
            </p>
          </div>
        </div>
      </section>

      <section class="px-5 pb-5 sm:px-8 sm:pb-8 lg:px-12 lg:pb-12">
        <div
          class="relative mx-auto max-w-[1440px] overflow-hidden rounded-[2.5rem] bg-[#7d28dc] px-6 py-20 text-center text-white sm:px-10 sm:py-28 lg:rounded-[3.5rem] lg:py-36"
        >
          <div class="cta-orb cta-orb-one"></div>
          <div class="cta-orb cta-orb-two"></div>
          <img
            src="/app-icon-256.png"
            alt=""
            class="relative mx-auto size-24 rounded-[24px] shadow-2xl sm:size-28 sm:rounded-[28px]"
          />
          <h2
            class="relative mx-auto mt-8 max-w-4xl text-[clamp(3rem,7vw,7rem)] leading-[0.88] font-semibold tracking-[-0.065em] text-balance"
          >
            Make this year visible.
          </h2>
          <p
            class="relative mx-auto mt-6 max-w-lg text-lg leading-8 text-white/65"
          >
            See what has passed, what is happening now, and what still has room
            to begin.
          </p>
          <a
            href={appStoreUrl}
            class="relative mt-9 inline-flex items-center gap-2 rounded-full bg-white px-7 py-4 font-semibold text-[#4d168e] shadow-xl transition hover:-translate-y-0.5 hover:bg-white/90"
          >
            <span class="text-lg" aria-hidden="true"></span>
            Get Milestones for Mac
          </a>
        </div>
      </section>
    </main>

    <footer
      class="mx-auto flex max-w-[1440px] flex-col gap-5 px-5 py-9 text-sm text-black/45 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12"
    >
      <p>© {new Date().getFullYear()} Milestones</p>
      <div class="flex gap-6">
        <a href={privacyUrl} class="transition hover:text-black">Privacy</a>
        <a href={supportUrl} class="transition hover:text-black">Support</a>
      </div>
    </footer>
  </body>
</html>
